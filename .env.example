# ============================================================================================
# LUMA - copy this file to ".env" and fill in the values marked REQUIRED.
# NEVER commit ".env". The old .env.example contained what looked like a real ElevenLabs key:
# treat that key as leaked and rotate it in the ElevenLabs dashboard.
# ============================================================================================

# ---------- Sign-in ----------
ALLOWED_EMAIL_DOMAIN=tuf.edu.pk
# leave EMPTY to use the email-only sign-in below (no Google / OAuth needed)
GOOGLE_CLIENT_ID=
# 1 = sign in with just a @tuf.edu.pk email (no password, no Google). Set 0 + GOOGLE_CLIENT_ID to require Google.
DEV_LOGIN=1
# REQUIRED with more than one worker (all workers must share it): python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_DAYS=30
# comma separated; may read GET /api/admin/failures
ADMIN_EMAILS=

# ---------- Gemini (REQUIRED: Live voice teacher + default text model) ----------
# REQUIRED
GEMINI_API_KEY=
# PRIMARY VOICE of every live lesson
GEMINI_LIVE_MODEL=gemini-3.8-live
# written notes / normal chat (first in the fallback chain)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LIVE_VOICE_FEMALE=Sulafat
GEMINI_LIVE_VOICE_MALE=Charon

# ---------- Fallback text models (optional but recommended: failover when Gemini is rate limited) ----------
# which one is tried first: gemini | groq | claude
LLM_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---------- Normal (non-live) voice ----------
# speech-to-text: groq (Whisper)
VOICE_PROVIDER=groq
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FEMALE=
ELEVENLABS_VOICE_ID_MALE=

# ---------- Redis (shared state across workers: usage cap, cool-downs, resume checkpoints, failure log, lesson locks) ----------
# docker-compose sets this for you (redis://luma_redis:6379/0). Hosted Redis: rediss://default:PASSWORD@HOST:6379/0
# Empty = in-memory fallback (one process only: fine for development, NOT for production). If Redis goes down at run time LUMA keeps working from memory.
REDIS_URL=
REDIS_PREFIX=luma
# seconds per Redis call before falling back
REDIS_TIMEOUT=1.5
# how long an unfinished answer can still be resumed
CHECKPOINT_TTL_SECONDS=3600
# entries kept in the Redis failure stream
FAILURE_LOG_MAX=5000

# ---------- LLM judge + guardrails (small model checks language and quality before the student sees an answer) ----------
JUDGE_ENABLED=1
# gemini | groq
JUDGE_PROVIDER=gemini
# empty = GEMINI_MODEL; set a small/fast one, e.g. a Flash-Lite model
JUDGE_MODEL=
JUDGE_GROQ_MODEL=llama-3.1-8b-instant
# judge too slow = fail open (answer released, failure logged)
JUDGE_TIMEOUT_SECONDS=3
# characters held back and judged before the first words are shown
JUDGE_HEAD_CHARS=280
# regenerations using the judge's instructions
JUDGE_MAX_RETRIES=1
# deliver | block (after the retries are used up)
JUDGE_FAIL_POLICY=deliver

# ---------- Retry / failover ----------
# extra tries on the same provider for transient errors
LLM_RETRIES=1
LLM_RETRY_BASE_SECONDS=0.4
# no first token by then = fail over to the next provider
LLM_FIRST_TOKEN_TIMEOUT=12

# ---------- Live lesson behaviour ----------
# one lesson lasts at most 20 minutes
LIVE_MAX_SECONDS=1200
# simultaneous lessons across all workers (Gemini quota / cost guard)
LIVE_MAX_CONCURRENT=4
# automatic reconnects to Gemini per lesson
LIVE_RECONNECTS=4
# restart the voice once if it speaks the wrong language
LIVE_LANGUAGE_GUARD=1
# question asked, teacher silent for this long = turn closed, student told to ask again
LIVE_FIRST_AUDIO_SECONDS=25
# teacher went quiet without finishing = turn closed
LIVE_TURN_IDLE_SECONDS=10
# after Gemini says it finished generating, wait this long for its 'turn complete' (it can arrive late or never)
LIVE_GENERATION_GRACE_SECONDS=1.5
# speech heard this long after the teacher began = a NEW question
LIVE_LATE_TRANSCRIPT_GRACE=2.0
# keep-alive for phones and proxies
LIVE_PING_SECONDS=15

# ---------- Limits ----------
MAX_MESSAGES_PER_USER_PER_DAY=50
MAX_TOKENS_PER_RESPONSE=4096
GROQ_MAX_TOKENS_PER_RESPONSE=4000
GROQ_TPM_LIMIT=8000

# ---------- HTTPS (docker-compose frontend) ----------
# addresses the self-signed certificate is made for (comma separated)
LUMA_HOSTS=localhost,127.0.0.1
HTTPS_PORT=8443



# ---------- PostgreSQL (async SQLAlchemy 2.0 + asyncpg) ----------
# docker-compose starts the database from these three and builds DATABASE_URL for the backend itself.
POSTGRES_USER=luma
POSTGRES_PASSWORD=change_me_to_a_long_random_password
POSTGRES_DB=luma
# Only needed when you run uvicorn on your own PC (not in Docker):
DATABASE_URL=postgresql+asyncpg://luma:change_me_to_a_long_random_password@localhost:5432/luma
# uvicorn worker processes per backend container. Database connections = WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW) must stay below Postgres max_connections (100).
WEB_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# seconds a request waits for a free connection before DB_UNAVAILABLE
DB_POOL_TIMEOUT=10
# replace connections older than this many seconds
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=10000
# retries of transient database errors (restart, dropped connection, deadlock)
DB_RETRIES=2
# 1 when PgBouncer (transaction mode) sits in front of Postgres
DB_PGBOUNCER=0



